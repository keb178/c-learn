{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: 编译当前文件",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "运行当前文件 (弹出CMD窗口)",
            "type": "process",
            "command": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/c",
                "start",
                "cmd",
                "/K",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "dependsOn": "C/C++: 编译当前文件",
            "problemMatcher": []
        }
    ]
}
